# Copy to .env and fill in. Never commit a filled-in .env.
# Postgres connection string. Local docker-compose default shown.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillexchange
# Supabase example (uncomment to use):
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# If true, new skills/versions go live immediately without moderator review.
# Keep false in production.
AUTO_APPROVE=false

# API listen address/port (local dev only; the deploy platform sets these)
API_HOST=0.0.0.0
API_PORT=8000
